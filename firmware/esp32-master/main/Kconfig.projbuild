menu "Lllight Master"
config LLLIGHT_DEMO_AUTO_START
    bool "Auto-start demo when READY (bench use only)"
    default n
endmenu
menu "One-way Pico transport"
config LLLIGHT_PICO_UART_PORT
    int "Pico UART number"
    default 1
config LLLIGHT_PICO_UART_TX_PIN
    int "TX GPIO connected to configured Pico RX GPIO"
    default 18
config LLLIGHT_PICO_BENCH_RESET_LOOP
    bool "Send RESET_OUTPUTS to Pico every second for physical UART bench testing"
    default n
endmenu
menu "Desktop serial transport"
config LLLIGHT_DESKTOP_UART_PORT
    int "Dedicated desktop UART number"
    default 2
config LLLIGHT_DESKTOP_UART_TX_PIN
    int "Desktop UART TX GPIO"
    default 25
config LLLIGHT_DESKTOP_UART_RX_PIN
    int "Desktop UART RX GPIO"
    default 26
endmenu
